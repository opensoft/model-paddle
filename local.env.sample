# Local-machine paths and per-host overrides. Copy to `local.env` (which is
# .gitignored) and edit. The build scripts source `build-manifest.env` first
# (the verified matrix); a local.env here would override after.
#
# Common overrides:

# Different gfx target / ROCm install (for non-gfx1151 hosts):
# export AMDGPU_TARGETS="gfx1100"
# export ROCM_PATH="/opt/rocm-7.0.0"

# Different Python ABI:
# export PYTHON_BIN="python3.11"

# Different cache location (e.g. on a faster disk):
# export PADDLE_BUILD_ROOT="/mnt/fast/paddle-rocm"

# Build parallelism cap (defaults to nproc/2 in the build script; reduce on
# low-RAM hosts to avoid OOM during the libpaddle.so link step):
# export CMAKE_BUILD_PARALLEL_LEVEL=4
