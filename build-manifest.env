# Verified default build matrix for the current ROCm Paddle source-build path.
#
# This file is the **reviewable claim** about which Paddle/ROCm/Python/GPU
# combination this repo has actually verified. It is sourced by build/verify
# scripts to populate defaults — but every variable respects pre-set values,
# so you can override per-host without editing this file:
#
#   AMDGPU_TARGETS=gfx1100 ROCM_PATH=/opt/rocm-7.0.0 \
#     scripts/rebuild-and-verify-rocm-wheel.sh
#
# Local-machine paths (cache locations, venvs) live in `local.env.sample` —
# copy to `local.env` and edit to taste. They are not part of the verified
# matrix.

# ---- Verified matrix (override per-host as needed) ----
export PADDLE_TAG="${PADDLE_TAG:-v3.3.1}"
export ROCM_PATH="${ROCM_PATH:-/opt/rocm-7.2.0}"
export AMDGPU_TARGETS="${AMDGPU_TARGETS:-gfx1151}"
export PYTHON_BIN="${PYTHON_BIN:-python3.12}"

# ---- Compiler defaults for the verified path ----
export PADDLE_HOST_CC="${PADDLE_HOST_CC:-$ROCM_PATH/llvm/bin/amdclang}"
export PADDLE_HOST_CXX="${PADDLE_HOST_CXX:-$ROCM_PATH/llvm/bin/amdclang++}"

# ---- Local cache/output paths ----
# (These are not part of the verified matrix; override via local.env or env.)
export PADDLE_BUILD_ROOT="${PADDLE_BUILD_ROOT:-$HOME/.cache/ledgerlinc/paddle-rocm}"
export PADDLE_WHEELHOUSE="${PADDLE_WHEELHOUSE:-$PADDLE_BUILD_ROOT/wheelhouse}"
export PADDLE_BUILD_VENV="${PADDLE_BUILD_VENV:-$PADDLE_BUILD_ROOT/.venv-build}"
